# Mẫu cho file `.env` — phần DÙNG CHUNG cho mọi môi trường và không phải secret.
#
# Config được tách theo môi trường. `src/config/env.ts` nạp lần lượt, dotenv KHÔNG ghi đè biến
# đã có nên thứ tự nạp chính là thứ tự ưu tiên:
#
#   biến thật (shell / secret manager) > .env.<mode>.local > .env.<mode> > .env.local > .env
#
# `<mode>` = NODE_ENV, do lệnh chạy quyết định (`cross-env` trong package.json):
#   npm run dev        -> development -> .env.development -> db `market-dev`
#   npm run start:prod -> production  -> .env.production  -> db `market-pro`
#   npm test           -> test        -> mongodb-memory-server, không đọc MONGO_URI của file
#
# Copy 2 file để chạy được local:
#   cp .env.example .env
#   cp .env.development.example .env.development   # rồi điền MONGO_URI + JWT secret
#
# KHÔNG đặt NODE_ENV / MONGO_URI / JWT_SECRET vào file này — xem lý do trong `.env.development.example`.
# Chỉ khai đúng những biến `src/config/env.ts` khai báo. Biến thừa không được zod validate,
# không ai đọc, và chỉ khiến người sau tưởng tính năng đó đã chạy.

# App
PORT=5000
API_PREFIX=/api/v1

# Auth - thời hạn token giống nhau ở mọi môi trường; SECRET thì không (nằm ở file từng env).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Khoá mở POST /auth/bootstrap-master — endpoint dựng tài khoản master ĐẦU TIÊN.
# ĐỂ TRỐNG là mặc định đúng: thiếu biến này thì endpoint trả 404, coi như không tồn tại.
# Chỉ set khi cần dựng master, tối thiểu 32 ký tự, và GỠ RA ngay sau khi xong:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_SETUP_TOKEN=

# Nhịp quét của người duyệt máy (Agenda human-interval)
MACHINE_REVIEW_EVERY=2 minutes

# Admin API cho job don anh mo coi — thieu bo ba thi job tu tat
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ghim
IMAGE_CLEANUP_EVERY=24 hours
