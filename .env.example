# Mẫu cho môi trường LOCAL. Production KHÔNG dùng file này: đặt biến qua secret manager của
# nơi deploy. Dùng chung một `.env` cho cả hai nghĩa là JWT_SECRET của prod nằm sẵn trên máy
# dev — ai có file đó tự ký được token hợp lệ cho mọi user, mọi org trên production.
#
# Chỉ khai đúng những biến `src/config/env.ts` khai báo. Biến thừa không được zod validate,
# không ai đọc, và chỉ khiến người sau tưởng tính năng đó đã chạy.

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
# Cần replica set (transaction khi tạo Organization + owner). Chạy ngoài docker-compose thì
# thêm directConnection=true vì replica set quảng bá host là `mongo:27017`.
# Luôn ghi TÊN DATABASE trong URI: bỏ trống thì driver rơi về db mặc định `test`, và trên
# cluster dùng chung đó là chỗ của app khác — seed/migration sẽ xoá nhầm dữ liệu của họ.
# `npm run seed` / `seed:bulk` tự từ chối chạy khi host KHÔNG phải localhost/127.0.0.1/mongo,
# vì hai script đó xoá sạch collection trước khi ghi (xem scripts/assertDisposableDb.ts).
MONGO_URI=mongodb://localhost:27017/cho-tot-clone?directConnection=true

# Multi-tenant - domain gốc để tách subdomain thành Organization.slug (hungvuong.app.com).
# Bỏ trống ở local: login gửi kèm `orgSlug` trong body, các route khác lấy org từ JWT.
APP_BASE_DOMAIN=

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional) - bỏ trống thì rate limit chạy in-memory và socket chỉ đúng khi 1 instance
REDIS_URL=

# Upload (S3) - optional
AWS_S3_BUCKET=
AWS_REGION=

# CORS whitelist - comma separated
CORS_ORIGINS=http://localhost:3000
