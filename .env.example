# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb://localhost:27017/cho-tot-clone

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional) - bỏ trống thì rate limit chạy in-memory và socket chỉ đúng khi 1 instance
REDIS_URL=

# Upload (S3) - optional
AWS_S3_BUCKET=
AWS_REGION=

# CORS whitelist - comma separated
CORS_ORIGINS=http://localhost:3000
