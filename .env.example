# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb+srv://tantaiit3000_db_user:ilQnhgumOk3IGxiX@cluster0.de8q7ql.mongodb.net/

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional - cache / rate limit / queue)
REDIS_URL=redis://localhost:6379

# Upload (S3) - optional
AWS_S3_BUCKET=
AWS_REGION=

# CORS whitelist - comma separated
CORS_ORIGINS=http://localhost:3000

# Optional: host binding (useful in Docker)
HOST=0.0.0.0

# SMTP (optional) - used for transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Marketplace <no-reply@marketplace.local>"

# Frontend / admin defaults
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=admin@123456
