# Mẫu cho `.env.development` — nạp khi NODE_ENV=development (`npm run dev`, `npm run seed`).
# Copy: cp .env.development.example .env.development

# Database - LUÔN ghi tên db trong URI: bỏ trống thì driver rơi về db mặc định `test`, mà trên
# cluster dùng chung đó là chỗ của app khác — seed/migration sẽ xoá nhầm dữ liệu của họ.
#
# Chỉ trỏ vào db develop (`market-dev`), không bao giờ vào `market-pro`: `npm run seed` xoá sạch
# mọi collection trước khi ghi. Chốt an toàn ở `scripts/assertDisposableDb.ts`.
#
# Mongo local ngoài docker-compose cần `?directConnection=true` (replica set quảng bá host là
# `mongo:27017`), còn Atlas thì dùng chuỗi `mongodb+srv://...`:
#   mongodb://localhost:27017/market-dev?directConnection=true
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/market-dev?retryWrites=true&w=majority

# DNS cho resolver nội bộ của Node (c-ares) — để TRỐNG, chỉ điền khi máy bạn bị lỗi này:
# `querySrv ECONNREFUSED _mongodb._tcp...` sau ~20ms trong khi nslookup/trình duyệt vẫn chạy.
# Đó là c-ares đọc hụt cấu hình DNS của Windows (nhiều adapter ảo WSL/Hyper-V/ICS) rồi rơi về
# 127.0.0.1. Đặt DNS tĩnh trong Windows KHÔNG chữa được. Khi đó: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=


# Auth - secret của dev phải KHÁC production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# Số hop reverse proxy trước server. Dev chạy thẳng = 0. Xem `.env.production.example`.
TRUST_PROXY=0

# Redis (optional) - bỏ trống thì rate limit chạy in-memory và socket chỉ đúng khi 1 instance

# CORS whitelist - comma separated
CORS_ORIGINS=http://localhost:3000

# Đăng nhập Google — client ID được PHÉP, phân tách bằng dấu phẩy.
# Là DANH SÁCH vì một app Expo có ba client ID (web / iOS / Android) và `aud` của id_token
# là đúng cái client đã phát ra nó. Bỏ trống = TẮT đường /auth/google (route trả 503).
GOOGLE_CLIENT_IDS=

# Chu kỳ job nền (agenda) — cú pháp human-interval. Bỏ trống = mặc định trong src/config/env.ts.
MACHINE_REVIEW_EVERY=
LISTING_EXPIRY_EVERY=
UNVERIFIED_CLEANUP_EVERY=
# Tài khoản chưa xác thực email quá chừng này ngày (và không có tài sản) bị xoá cứng.
UNVERIFIED_TTL_DAYS=
WALLET_RECONCILE_EVERY=
IMAGE_CLEANUP_EVERY=

# Mức log: error | warn | info | debug. Bỏ trống = info ở production, debug ở dev.
LOG_LEVEL=

# Push notification (docs/architecture/push-notification.plan.md). Tắt tới khi app có dev build
# kèm credential FCM/APNs thật. EXPO_ACCESS_TOKEN: bắt buộc khi bật Enhanced push security trên EAS.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
PUSH_DISPATCH_EVERY=
PUSH_RECEIPTS_EVERY=
