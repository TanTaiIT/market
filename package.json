{
  "name": "cho-tot-clone",
  "version": "1.0.0",
  "description": "Marketplace/Classifieds backend (Chợ Tốt clone) - Express + MongoDB + TypeScript, feature-based architecture",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "oxlint --fix && npm run format",
    "lint:check": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "seed": "tsx scripts/seed.ts",
    "prepare": "husky install"
  },
  "keywords": ["marketplace", "classifieds", "express", "mongodb", "typescript"],
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.1",
    "@aws-sdk/client-s3": "^3.596.0",
    "@node-rs/bcrypt": "^1.10.4",
    "@scalar/express-api-reference": "^0.4.170",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.0.1",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "rate-limiter-flexible": "^5.0.3",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@oxlint/binding-win32-x64-msvc": "^1.77.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "mongodb-memory-server": "^9.2.0",
    "oxlint": "^1.77.0",
    "pino-pretty": "^11.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.ts": ["oxlint --fix", "prettier --write"]
  }
}
