{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // moduleResolution để MẶC ĐỊNH theo "module": "commonjs" (= node10, y hệt "node").
    // Ghi tường minh "node" thì TS 6 báo TS5107 (deprecated, TS 7 bỏ hẳn) ngay trên file này,
    // mà VS Code đang được trỏ vào TS 6 của repo cha qua "js/ts.tsdk.path".
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    // Cô lập @types của riêng project này — tránh kéo @types từ node_modules của repo cha
    // (features/API nằm lồng trong repo Vue salon dùng TypeScript 3.6 cũ).
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
