{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    // Cô lập @types của riêng project này — tránh kéo @types từ node_modules của repo cha
    // (features/API nằm lồng trong repo Vue salon dùng TypeScript 3.6 cũ).
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": "src",
    "paths": {
      "@config/*": ["config/*"],
      "@features/*": ["features/*"],
      "@common/*": ["common/*"],
      "@middlewares/*": ["middlewares/*"],
      "@sockets/*": ["sockets/*"],
      "@jobs/*": ["jobs/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
