# Mẫu cho `.env.production` — nạp khi NODE_ENV=production (`npm run start:prod`, image Docker).
#
# File thật CHỈ dùng để chạy thử bản build production trên máy local. Deploy thật đặt biến qua
# secret manager của nơi chạy — biến thật thắng mọi file nên không cần mang file này lên server.
# Dùng chung một bộ secret cho dev và prod nghĩa là token ký ở máy dev hợp lệ thật trên production.

# Database - db production (`market-pro`). Nằm trong danh sách CẤM của
# `scripts/assertDisposableDb.ts`: seed/seed:bulk từ chối chạy vào đây, kể cả khi có
# SEED_ALLOW_REMOTE=yes.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/market-pro?retryWrites=true&w=majority


# Auth - giá trị thật đặt ở secret manager, KHÔNG ghi vào file. Server production TỪ CHỐI boot
# khi còn thấy chuỗi mẫu dưới đây, khi secret ngắn hơn 32 ký tự, hoặc khi hai secret trùng nhau
# (`assertRuntimeSecrets` trong src/config/env.ts). Sinh hai giá trị KHÁC NHAU:
#   openssl rand -base64 48
JWT_SECRET=set_via_secret_manager
JWT_REFRESH_SECRET=set_via_secret_manager

# Số hop reverse proxy đứng trước server (Render / nginx / load balancer = 1). Để 0 sau proxy là
# mọi người dùng chung một IP → rate limit đăng nhập gom cả sàn vào một xô 10 lượt/phút. Đặt 1
# khi KHÔNG có proxy là để client tự khai IP qua X-Forwarded-For.
TRUST_PROXY=1

# Nơi nhận lỗi 5xx. Để trống = tắt hẳn, log vẫn ghi bình thường — nhưng trên production thì
# ĐỪNG để trống: log của free tier giữ ngắn và không gom nhóm, còn người dùng gặp lỗi 500 thì
# đa số không báo. Lấy DSN ở Settings > Client Keys của project Sentry.
SENTRY_DSN=

# Redis (optional) - không có thì rate limit chạy in-memory và Socket.IO chỉ đúng khi 1 instance.

# CORS whitelist - comma separated. Production KHÔNG để localhost.
CORS_ORIGINS=https://example.com

# Đăng nhập Google — client ID được PHÉP, phân tách bằng dấu phẩy.
# Là DANH SÁCH vì một app Expo có ba client ID (web / iOS / Android) và `aud` của id_token
# là đúng cái client đã phát ra nó. Bỏ trống = TẮT đường /auth/google (route trả 503).
GOOGLE_CLIENT_IDS=

# Chu kỳ job nền (agenda) — cú pháp human-interval. Bỏ trống = mặc định trong src/config/env.ts.
MACHINE_REVIEW_EVERY=
LISTING_EXPIRY_EVERY=
UNVERIFIED_CLEANUP_EVERY=
# Tài khoản chưa xác thực email quá chừng này ngày (và không có tài sản) bị xoá cứng.
UNVERIFIED_TTL_DAYS=
WALLET_RECONCILE_EVERY=
IMAGE_CLEANUP_EVERY=

# Mức log: error | warn | info | debug. Bỏ trống = info ở production, debug ở dev.
LOG_LEVEL=
